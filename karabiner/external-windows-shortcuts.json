        {
            "description": "External keyboards: Ctrl-click selects multiple files in Finder with external mice",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "left_control",
                        "modifiers": {
                            "optional": [
                                "any"
                            ]
                        }
                    },
                    "to": [
                        {
                            "set_variable": {
                                "name": "mwk_external_left_control_held",
                                "value": true
                            }
                        },
                        {
                            "key_code": "left_control"
                        }
                    ],
                    "conditions": [
                        {
                            "type": "device_if",
                            "identifiers": [
                                {
                                    "is_keyboard": true,
                                    "is_built_in_keyboard": false
                                }
                            ]
                        }
                    ],
                    "to_after_key_up": [
                        {
                            "set_variable": {
                                "name": "mwk_external_left_control_held",
                                "value": false
                            }
                        }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "right_control",
                        "modifiers": {
                            "optional": [
                                "any"
                            ]
                        }
                    },
                    "to": [
                        {
                            "set_variable": {
                                "name": "mwk_external_right_control_held",
                                "value": true
                            }
                        },
                        {
                            "key_code": "right_control"
                        }
                    ],
                    "conditions": [
                        {
                            "type": "device_if",
                            "identifiers": [
                                {
                                    "is_keyboard": true,
                                    "is_built_in_keyboard": false
                                }
                            ]
                        }
                    ],
                    "to_after_key_up": [
                        {
                            "set_variable": {
                                "name": "mwk_external_right_control_held",
                                "value": false
                            }
                        }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "pointing_button": "button1",
                        "modifiers": {
                            "mandatory": [
                                "left_control"
                            ],
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [
                        {
                            "pointing_button": "button1",
                            "modifiers": [
                                "left_command"
                            ]
                        }
                    ],
                    "conditions": [
                        {
                            "type": "frontmost_application_if",
                            "bundle_identifiers": [
                                "^com\\.apple\\.finder$"
                            ]
                        },
                        {
                            "type": "variable_if",
                            "name": "mwk_external_left_control_held",
                            "value": true
                        },
                        {
                            "type": "device_if",
                            "identifiers": [
                                {
                                    "is_pointing_device": true
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "pointing_button": "button1",
                        "modifiers": {
                            "mandatory": [
                                "right_control"
                            ],
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [
                        {
                            "pointing_button": "button1",
                            "modifiers": [
                                "left_command"
                            ]
                        }
                    ],
                    "conditions": [
                        {
                            "type": "frontmost_application_if",
                            "bundle_identifiers": [
                                "^com\\.apple\\.finder$"
                            ]
                        },
                        {
                            "type": "variable_if",
                            "name": "mwk_external_right_control_held",
                            "value": true
                        },
                        {
                            "type": "device_if",
                            "identifiers": [
                                {
                                    "is_pointing_device": true
                                }
                            ]
                        }
                    ]
                }
