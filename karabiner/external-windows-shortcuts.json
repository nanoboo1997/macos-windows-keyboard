{
    "title": "External Windows keyboard shortcuts",
    "rules": [
        {
            "description": "External keyboards: backtick toggles Thai-English; built-in and Shift preserved",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "grave_accent_and_tilde",
                        "modifiers": {
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "spacebar",
                            "modifiers": [
                                "left_control"
                            ],
                            "repeat": false
                        }
                    ],
                    "conditions": [
                        {
                            "type": "device_if",
                            "identifiers": [
                                {
                                    "is_keyboard": true,
                                    "is_built_in_keyboard": false
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "description": "External keyboards: Windows Ctrl C V X Z A; except Terminal",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "c",
                        "modifiers": {
                            "mandatory": [
                                "control"
                            ],
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "c",
                            "modifiers": [
                                "left_command"
                            ]
                        }
                    ],
                    "conditions": [
                        {
                            "type": "device_if",
                            "identifiers": [
                                {
                                    "is_keyboard": true,
                                    "is_built_in_keyboard": false
                                }
                            ]
                        },
                        {
                            "type": "frontmost_application_unless",
                            "bundle_identifiers": [
                                "^com\\.apple\\.Terminal$",
                                "^com\\.googlecode\\.iterm2$"
                            ]
                        }
                    ]
                },
