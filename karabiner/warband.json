{
    "title": "Warband",
    "rules": [
        {
            "description": "Warband: external keyboard Ctrl+X and backtick",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "x",
                        "modifiers": {
                            "mandatory": [
                                "control"
                            ],
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "x",
                            "modifiers": [
                                "left_control"
                            ]
                        }
                    ],
                    "conditions": [
                        {
                            "type": "device_if",
                            "identifiers": [
                                {
                                    "is_keyboard": true,
                                    "is_built_in_keyboard": false
                                }
                            ]
                        },
                        {
                            "type": "frontmost_application_if",
                            "bundle_identifiers": [
                                "^taleworlds\\.Mount-and-Blade$"
                            ]
                        }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "grave_accent_and_tilde",
                        "modifiers": {
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "spacebar",
                            "modifiers": [
                                "left_control"
                            ],
                            "repeat": false
                        },
                        {
                            "key_code": "grave_accent_and_tilde"
                        }
                    ],
                    "conditions": [
                        {
                            "type": "device_if",
                            "identifiers": [
                                {
                                    "is_keyboard": true,
                                    "is_built_in_keyboard": false
                                }
                            ]
                        },
                        {
                            "type": "frontmost_application_if",
                            "bundle_identifiers": [
                                "^taleworlds\\.Mount-and-Blade$"
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
